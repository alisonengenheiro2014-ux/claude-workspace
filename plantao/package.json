{
  "name": "plantao-maxgiga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de atendimento fora do horário e modo massivo para provedor de internet",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "simular": "tsx src/simulate.ts",
    "criar-usuario": "tsx src/criar-usuario.ts",
    "testar-sgp": "tsx src/testar-sgp.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
