# --- servidor ---
PORT=3000
PUBLIC_BASE_URL=https://plantao.seudominio.com.br
# gere com: openssl rand -hex 32
SESSION_SECRET=
TZ_ATENDIMENTO=America/Sao_Paulo

# --- banco ---
DATABASE_URL=postgres://plantao:troque-esta-senha@db:5432/plantao
POSTGRES_PASSWORD=troque-esta-senha

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
# modelo da conversa (texto e áudio transcrito)
MODEL_CONVERSA=claude-haiku-5-5
# modelo que analisa foto/vídeo do equipamento
MODEL_VISAO=claude-sonnet-5-5

# --- canal: meta | chatmix ---
CANAL=meta

# Meta (WhatsApp Cloud API oficial)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# MaxChat (sistema próprio — usar quando CANAL=chatmix)
# URL base do MaxChat: ex. https://srv3.chatmix.com.br
MAXCHAT_BASE_URL=
# Chave de API gerada em Configurações > API Keys no MaxChat
MAXCHAT_API_KEY=
# Número do canal WhatsApp principal (ex. 5527999990000)
MAXCHAT_CHANNEL_NUMBER=
# Segredo para validar o webhook (opcional, mas recomendado)
# Configure o mesmo valor em Automações no MaxChat como header X-MaxChat-Secret
MAXCHAT_WEBHOOK_SECRET=

# --- SGP: mock | http ---
SGP_MODO=mock
# endereço do SGP (Maxgiga: https://maxgiga.sgp.tsmx.com.br/api) e credenciais criadas em
# Administração > Integrações > Tokens
SGP_BASE_URL=
SGP_APP=
SGP_TOKEN=
# tipo de ocorrência usado ao abrir chamado (lista em /api/os/ocorrencia/tipo/list/)
SGP_OCORRENCIA_TIPO=5
# sinal da ONU abaixo disso (dBm) conta como sem conexão
SGP_SINAL_MINIMO_DBM=-30

# --- transcrição de áudio (servidor compatível com /v1/audio/transcriptions) ---
TRANSCRICAO_URL=http://whisper:8000/v1/audio/transcriptions
TRANSCRICAO_MODELO=Systran/faster-whisper-small

# --- textos ---
EMPRESA_NOME=Maxgiga

# --- rotinas ---
# a cada quantos minutos ler o SGP para detectar massivo
VARREDURA_MINUTOS=2
# massivo = pelo menos N clientes caídos em 10 min e X% da área offline
MASSIVO_MIN_CLIENTES=3
MASSIVO_PERCENTUAL=60
# conversa sem mensagem há N horas é encerrada (a próxima abre um atendimento novo)
CONVERSA_INATIVA_HORAS=12
# LGPD: histórico de conversas é apagado depois de N dias
RETENCAO_DIAS=180
# depois que um massivo normaliza, quanto tempo esperar o cliente confirmar antes da despedida automática
DESPEDIDA_MINUTOS=30
# liberação de confiança pela assistente (false = só libera após pagamento)
DESBLOQUEIO_CONFIANCA=true
# regras do prazo (o sistema decide, a IA só informa):
# nunca pagou ou menos de 3 meses: 24h · de 3 a 6 meses: 48h · 6+ meses e em dia: até 5 dias
# segunda liberação no mesmo ciclo de vencimento: no máximo 24h · terceira: não libera (vai para a equipe)
LIBERACAO_HORAS_CLIENTE_NOVO=24
LIBERACAO_MESES_INTERMEDIARIO=3
LIBERACAO_HORAS_INTERMEDIARIO=48
LIBERACAO_MESES_ANTIGO=6
LIBERACAO_DIAS_ANTIGO=5
# "em dia" = as últimas faturas (no mínimo 3) pagas até o vencimento ou até 2 dias depois
LIBERACAO_DIAS_TOLERANCIA=2
LIBERACAO_MIN_FATURAS_ANALISE=3
LIBERACAO_HORAS_SEGUNDA_NO_CICLO=24
LIBERACAO_MAX_POR_CICLO=2
