# --- servidor ---
PORT=3000
PUBLIC_BASE_URL=https://plantao.seudominio.com.br
# gere com: openssl rand -hex 32
SESSION_SECRET=
TZ_ATENDIMENTO=America/Sao_Paulo

# --- banco ---
DATABASE_URL=postgres://plantao:troque-esta-senha@db:5432/plantao
POSTGRES_PASSWORD=troque-esta-senha

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
# modelo da conversa (texto e áudio transcrito)
MODEL_CONVERSA=claude-haiku-5-5
# modelo que analisa foto/vídeo do equipamento
MODEL_VISAO=claude-sonnet-5-5

# --- canal: meta | chatmix ---
CANAL=meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- SGP: mock | http ---
SGP_MODO=mock
SGP_BASE_URL=
SGP_TOKEN=

# --- transcrição de áudio (servidor compatível com /v1/audio/transcriptions) ---
TRANSCRICAO_URL=http://whisper:8000/v1/audio/transcriptions
TRANSCRICAO_MODELO=Systran/faster-whisper-small

# --- textos ---
EMPRESA_NOME=Maxgiga

# --- rotinas ---
# a cada quantos minutos ler o SGP para detectar massivo
VARREDURA_MINUTOS=2
# massivo = pelo menos N clientes caídos em 10 min e X% da área offline
MASSIVO_MIN_CLIENTES=3
MASSIVO_PERCENTUAL=60
# conversa sem mensagem há N horas é encerrada (a próxima abre um atendimento novo)
CONVERSA_INATIVA_HORAS=12
# LGPD: histórico de conversas é apagado depois de N dias
RETENCAO_DIAS=180
